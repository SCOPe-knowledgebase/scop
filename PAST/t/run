cd "$(dirname "$0")/.." || exit 1
PERL=${PERL:-/lab/bin/perl}
[ -x "$PERL" ] || PERL=perl
"$PERL" -c snapshot.pl || exit 1
"$PERL" -c prune.pl || exit 1
"$PERL" -c makelinks.pl || exit 1
exec "$PERL" t/harness.pl "$@"
